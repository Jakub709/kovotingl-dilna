{
  "name": "kovotingl-dilna",
  "productName": "KovoTingl Dilna",
  "version": "0.5.0",
  "description": "Jednoduché kreslení konstrukcí, kusovník a nářez pro dílnu.",
  "author": "KovoTingl",
  "private": true,
  "license": "UNLICENSED",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node tools/test-core.mjs && node --test tools/regressions.mjs tools/spatial.test.mjs tools/fabrication.test.mjs tools/solids.test.mjs tools/advanced.test.mjs",
    "dist": "electron-builder --win --dir",
    "dist:portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "cz.kovotingl.dilna",
    "productName": "KovoTingl Dilna",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "build/icon.png"
    ],
    "artifactName": "KovoTingl-Dilna-${version}.${ext}",
    "win": {
      "icon": "build/icon.ico",
      "target": "portable"
    }
  }
}
